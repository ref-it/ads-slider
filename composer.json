{
    "$schema": "https://getcomposer.org/schema.json",
    "name": "bedo2991/ads-slider",
    "type": "project",
    "description": "A digital signage software based on Laravel",
    "keywords": [
        "digital",
        "signage",
        "laravel",
        "menu",
        "video",
        "events",
        "ads",
        "slider",
        "nina"
    ],
    "license": "EUPL-1.2",
    "authors": [
        {
            "name": "Francesco Bedini"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-bcmath": "*",
        "ext-ctype": "*",
        "ext-curl": "*",
        "ext-dom": "*",
        "ext-fileinfo": "*",
        "ext-filter": "*",
        "ext-hash": "*",
        "ext-mbstring": "*",
        "ext-openssl": "*",
        "ext-pcre": "*",
        "ext-pdo": "*",
        "ext-session": "*",
        "ext-tokenizer": "*",
        "ext-xml": "*",
        "guzzlehttp/guzzle": "^7.5",
        "ksubileau/color-thief-php": "^2.0.0",
        "laracasts/flash": "^3.0",
        "laravel/framework": "^13.6",
        "laravel/reverb": "@beta",
        "laravel/socialite": "^5.29",
        "laravel/tinker": "^3.0",
        "laravel/ui": "^4.0",
        "livewire/livewire": "^4.0",
        "opcodesio/log-viewer": "^3.8",
        "pusher/pusher-php-server": "^7.2",
        "resend/resend-php": "^0.18.0",
        "socialiteproviders/manager": "^4.4",
        "socialiteproviders/openidconnect": "^1.0",
        "symfony/http-client": "^7.0",
        "symfony/mailgun-mailer": "^7.0",
        "ycs77/laravel-form-builder-bs4": "^1.0"
    },
    "require-dev": {
        "ext-pdo_sqlite": "*",
        "fakerphp/faker": "^1.23",
        "kkomelin/laravel-translatable-string-exporter": "^1.22",
        "laravel/pint": "^1.14",
        "laravel/sail": "^1.41",
        "laravel/telescope": "^5.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.6",
        "phpunit/phpunit": "^12.0",
        "spatie/laravel-ignition": "^2.4",
        "squizlabs/php_codesniffer": "^3.5"
    },
    "tempRemove": {
        "enlightn/enlightn": "^2.10"
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "backup_platform": {
            "php": "8.3"
        }
    },
    "extra": {
        "laravel": {
            "dont-discover": [
                "laravel/telescope"
            ]
        }
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi",
            "@php -r \"file_exists('database/database.sqlite') || touch('database/database.sqlite');\"",
            "@php artisan migrate --graceful --ansi"
        ],
        "dev": [
            "Composer\\Config::disableProcessTimeout",
            "npx concurrently -c \"#93c5fd,#c4b5fd,#fb7185,#fdba74,#50C878\" \"php artisan serve\" \"php artisan queue:listen --tries=1\" \"php artisan pail --timeout=0\" \"npm run dev\" \"php artisan reverb:start --debug\" --names=server,queue,logs,vite,reverb"
        ],
        "test": [
            "@php artisan config:clear --ansi",
            "@php artisan test"
        ]
    }
}
